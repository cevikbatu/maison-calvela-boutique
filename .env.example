# Public build-time indexing switch: empty defaults to disabled.
VITE_PUBLIC_INDEXING_ENABLED=
# App server only: private Node upload service origin.
PHOTO_UPLOAD_SERVER_URL=
# Node upload service only. Never add VITE_ to this name.
PHOTO_UPLOAD_SERVICE_ROLE_KEY=
PHOTO_UPLOAD_PORT=
# Browser-safe Supabase URL and publishable key (required by the storefront).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same public values, used as the server-side rendering fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Public site origin used in indexing metadata.
VITE_PUBLIC_SITE_URL=
# Server only: bypasses RLS. Never add VITE_ to this name.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated exact HTTPS origins allowed to send owner invitations.
OWNER_BOOTSTRAP_ALLOWED_ORIGINS=
